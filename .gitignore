# --- Python bytecode / caches -------------------------------------------
__pycache__/
*.pyc
*.pyo
*.pyd

# --- virtualenvs --------------------------------------------------------
.venv/
venv/
env/

# --- Swiss Ephemeris data files ----------------------------------------
# Downloaded third-party binary ephemeris data, not project source.
ephe/

# --- scratchpad: throwaway patch scripts and local run logs ------------
# A bad patch is recoverable from HEAD precisely while these stay out of it.
#
# NOTHING WHOSE OUTPUT IS TRACKED MAY LIVE HERE. A generator in scratch/ is
# a tracked page a fresh clone cannot rebuild -- the calendar was
# reproducible and the documents about it were not. Those five moved to
# tools/ (see README's layout block); what remains here is probes, one-off
# source patchers and debug dumps, none of which writes a tracked file.
patch_*.py
scratch/
tmp_*.py
tmp_*.json
scratch*.py
*.log
commit_message.txt
batch*_commit_msg.txt

# --- editor / OS noise --------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini

# NOTE: build/ is deliberately NOT ignored.
#   build/astronomy_2027.json        deterministic artifact whose sha256 we track
#   build/STEP3_REPORT.md            project record
#   build/STEP4_DECISIONS.md         project record
# Their diffs are the most valuable thing this repo provides: "the build hash
# moved, and here is exactly which records changed" is answerable by `git diff`.
calib_commit_msg.txt
b5msg.txt
b6msg.txt
b7msg.txt
b8msg.txt
b9msg.txt
b10msg.txt

# Backtest-only astronomy layers 2000-2024 (tools/build_year.py, ~13 MB each). Deterministic
# and rebuilt on demand by tools/backtest_gold.py, so not tracked; 2025-2027 are.
build/astronomy_20[01][0-9].json
build/astronomy_20[01][0-9]_summary.txt
build/astronomy_2020.json
build/astronomy_2020_summary.txt
build/astronomy_202[1-4].json
build/astronomy_202[1-4]_summary.txt
build/pdfref/backtest/market_events_2000-2026.json.gz
build/astronomy_1999*
build/astronomy_2028*
build/pdfref/backtest/calendar_verdicts/
build/pdfref/backtest/*_label_history.json.gz

# --- generated HTML pages (user, 27 Nov 2026: keep only the two calendars) ---
# Tools still write their pages during a refresh; only these HTML files are tracked:
#   build/pdfref/ and reports/calendar_2026-11-24_to_2026-12-31_ET.html  (now to end of 2026)
#   build/pdfref/ and reports/calendar_2027_NY_master.html               (2027, New York time)
#   build/calendar_2027.html (base 2027 master; tests read it), data/source_2026.html and the
#   user's own Reference_materials/*.html sources.
build/pdfref/*.html
!build/pdfref/calendar_2026-11-24_to_2026-12-31_ET.html
!build/pdfref/calendar_2027_NY_master.html
reports/*.html
!reports/calendar_2026-11-24_to_2026-12-31_ET.html
!reports/calendar_2027_NY_master.html
build/reference_*.html
PROJECT_KNOWLEDGE.html
Reference_materials/extracted/*.html
# Calendar files and one-off outputs of the removed reports (user, 27 Nov 2026: remove what is no longer relevant).
build/pdfref/*.ics
!build/pdfref/calendar_2027_NY_master.ics
!build/pdfref/calendar_2027_NY_moon_layer.ics
reports/*.ics
!reports/calendar_2027_NY_master.ics
build/pdfref/day_report_*.json
build/pdfref/sky_changes_*.json
!build/pdfref/sky_changes_2026-11-01_to_2026-11-23_ET.json
!build/pdfref/sky_changes_2026-11-24_to_2026-12-31_ET.json
# day-data cache of tools/week_deep_dive.py (rebuilt on demand)
build/pdfref/backtest/days_*.json.gz
