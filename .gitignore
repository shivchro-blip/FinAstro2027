# --- Python bytecode / caches -------------------------------------------
__pycache__/
*.pyc
*.pyo
*.pyd

# --- virtualenvs --------------------------------------------------------
.venv/
venv/
env/

# --- Swiss Ephemeris data files ----------------------------------------
# Downloaded third-party binary ephemeris data, not project source.
ephe/

# --- scratchpad: throwaway patch scripts and local run logs ------------
# A bad patch is recoverable from HEAD precisely while these stay out of it.
#
# NOTHING WHOSE OUTPUT IS TRACKED MAY LIVE HERE. A generator in scratch/ is
# a tracked page a fresh clone cannot rebuild -- the calendar was
# reproducible and the documents about it were not. Those five moved to
# tools/ (see README's layout block); what remains here is probes, one-off
# source patchers and debug dumps, none of which writes a tracked file.
patch_*.py
scratch/
tmp_*.py
tmp_*.json
scratch*.py
*.log
commit_message.txt
batch*_commit_msg.txt

# --- editor / OS noise --------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini

# NOTE: build/ is deliberately NOT ignored.
#   build/astronomy_2027.json        deterministic artifact whose sha256 we track
#   build/STEP3_REPORT.md            project record
#   build/STEP4_DECISIONS.md         project record
# Their diffs are the most valuable thing this repo provides: "the build hash
# moved, and here is exactly which records changed" is answerable by `git diff`.
calib_commit_msg.txt
b5msg.txt
b6msg.txt
b7msg.txt
b8msg.txt
b9msg.txt
b10msg.txt
